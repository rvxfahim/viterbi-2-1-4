{#-
  Template for the unrolled (2,1,4) Viterbi decoder.

  Rendered by scripts/{{ generator }} into rtl/decoder.sv (7 stages,
  unterminated) and rtl/decoder_term.sv (10 stages, zero-tail terminated).
  Every branch metric's expected output pair is derived from the generator
  polynomials rather than typed in, so the two variants cannot drift apart.

  The structure deliberately matches the original hand-written decoder: one
  add-compare-select per clock edge, sequenced by steps_n (trellis stage) and
  stage_n (target state within the stage), with survivors recorded by
  overwriting the losing branch metric with the sentinel 3.
-#}
// -------------------------------------------------------------------------
// {{ module }}.sv -- GENERATED FILE, DO NOT EDIT
//
// Source:    rtl/gen/decoder.sv.j2
// Generator: scripts/{{ generator }}
// Regenerate with:  python scripts/gen_rtl.py
//
// Rate 1/2, constraint length K = 4, 8 trellis states.
//   g1 = 1111 (17 octal) -> out[1]
//   g0 = 1011 (13 octal) -> out[0]
//
// Block:     {{ msg_bits }} message bits{% if tail %} + {{ tail }} zero tail bits{% endif %} -> {{ stages }} trellis stages, {{ cw_bits }} code bits
// Decision:  hard
{% if terminate %}
// Trellis:   zero-tail terminated -- the encoder flushes K-1 = {{ tail }} zeros, so the
//            survivor is known to end in state 0 and traceback starts there.
{% else %}
// Trellis:   unterminated -- traceback starts from whichever of the 8 end
//            states carries the lowest path metric.  The last two message bits
//            are under-protected as a result; see docs/known-issues.md.
{% endif %}
// Latency:   {{ trellis_cycles }} trellis clocks + {{ traceback_cycles }} traceback clocks
// -------------------------------------------------------------------------

module {{ module }}(clk, reset, dat, out, ready);

  input clk;
  input reset;
  input [{{ cw_bits - 1 }}:0] dat;
  input ready;
  output reg [{{ msg_bits - 1 }}:0] out;
  reg [{{ cw_bits - 1 }}:0] data;
  logic high;
  logic low;
  assign high = 1;
  assign low = 0;
  logic [4:0]steps_n;
  logic [4:0]stage_n;
{% if not terminate %}
  reg[4:0] temp_states[0:7];
  reg[4:0] lowest_value;
{% endif %}
  reg[2:0] lowest_index;
  reg [2:0] returned_path;
  byte counter_for_path;
  byte pinOut;
  byte table_counter;

  typedef struct {
    logic [4:0]finalStates[0:7];
  } FinalHammingDistance;

  typedef struct {
    logic bits[0:1];
    logic decoded;
  } CorrectSequence;

  CorrectSequence bitSequence;

  typedef struct {
    bit recievedSequence[0:1];
{% for letter in letters %}
    bit[4:0] {{ letter }}Transition[0:1];
{% endfor %}
    logic [4:0] previousHammingDistance[0:7];
    logic [4:0] step;
    FinalHammingDistance hammingDistances;
  } HammingTable;

  HammingTable {{ tables | join(', ') }};
  FinalHammingDistance oldHam;

  always @ (posedge clk ) begin

    if(!reset) begin
      //initialize all memory variables/registers
      integer i;
      i=0;
{% for table in tables %}
      for (i = 0;i<8 ;i=i+1 ) begin
        {{ table }}.hammingDistances.finalStates[i] = 0;
      end
{% endfor %}
      data = dat;
      pinOut = 0;
{% for b in range(msg_bits) %}
      out[{{ b }}] = 0;
{% endfor %}
      steps_n = 1;
      stage_n = 0;
      table_counter = {{ stages }};
      // The original never cleared counter_for_path here, so a second decode
      // began with a stale counter of {{ stages + 1 }} and emitted nothing -- the design
      // worked exactly once per power-on.  See docs/known-issues.md #1.
      counter_for_path = 0;
      lowest_index = 0;
      returned_path = 0;
    end

    else begin
      //begin decoding

      if (steps_n==1) begin
        initialize_hamming_table(steps_n, data[{{ first_hi }}], data[{{ first_lo }}]);  //populate hamming table h1 partially
        copmute_for_step(stage_n);
        steps_n = steps_n+1;
      end
{% for stage in stage_blocks %}
      else if(steps_n=={{ stage.n }}) begin
{% for sub in stage.subs %}
{% set h = stage.table %}
{% set prev = stage.prev_table %}
        {% if loop.first %}if{% else %}else if{% endif %} (stage_n=={{ sub.stage_n }}) begin
{% if sub.compare %}
{% set b0 = sub.branches[0] %}
{% set b1 = sub.branches[1] %}
          {{ h }}.{{ b0.field }}[{{ b0.index }}] = compute_hamming_distance(data[{{ stage.bit_hi }}],data[{{ stage.bit_lo }}],{{ b0.out1 }},{{ b0.out0 }});
          {{ h }}.{{ b1.field }}[{{ b1.index }}] = compute_hamming_distance(data[{{ stage.bit_hi }}],data[{{ stage.bit_lo }}],{{ b1.out1 }},{{ b1.out0 }});
          if (({{ h }}.{{ b0.field }}[{{ b0.index }}] + {{ prev }}.hammingDistances.finalStates[{{ b0.pred }}])<({{ h }}.{{ b1.field }}[{{ b1.index }}] + {{ prev }}.hammingDistances.finalStates[{{ b1.pred }}])) begin
            {{ h }}.hammingDistances.finalStates[{{ sub.target }}] = {{ h }}.{{ b0.field }}[{{ b0.index }}] + {{ prev }}.hammingDistances.finalStates[{{ b0.pred }}];
            {{ h }}.{{ b1.field }}[{{ b1.index }}] = 3;
          end
          else begin
            {{ h }}.hammingDistances.finalStates[{{ sub.target }}] = {{ h }}.{{ b1.field }}[{{ b1.index }}] + {{ prev }}.hammingDistances.finalStates[{{ b1.pred }}];
            {{ h }}.{{ b0.field }}[{{ b0.index }}] = 3;
          end
{% else %}
{% set b0 = sub.branches[0] %}
          {{ h }}.{{ b0.field }}[{{ b0.index }}] = compute_hamming_distance(data[{{ stage.bit_hi }}],data[{{ stage.bit_lo }}],{{ b0.out1 }},{{ b0.out0 }});
          {{ h }}.hammingDistances.finalStates[{{ sub.target }}] = {{ h }}.{{ b0.field }}[{{ b0.index }}] + {{ prev }}.hammingDistances.finalStates[{{ b0.pred }}];
{% endif %}
{% if sub.last %}
          stage_n = 0;
          steps_n = steps_n+1;
{% else %}
          stage_n = stage_n+{{ sub.step }};
{% endif %}
        end
{% endfor %}
      end //end of step {{ stage.n }}
{% endfor %}

      // The original evaluated this block outside the reset if/else, so it ran
      // on reset edges too and was safe only because the testbenches held
      // ready low during reset.  See docs/known-issues.md #2.
      if(ready==1) begin
        if (counter_for_path==0) begin
{% if terminate %}
          // Terminated trellis: the survivor ends in state 0 by construction,
          // so there is nothing to search for.
          lowest_index = 0;
{% else %}
          for (int j =0;j<8;j=j+1) begin
            temp_states[j] = {{ tables[-1] }}.hammingDistances.finalStates[j];
          end
          lowest_value = temp_states[0];
          lowest_index = 0;
          for (int l = 0; l<8; l=l+1) begin
            //find the lowest final path metric and remember which state holds it
            if (temp_states[l]<lowest_value ) begin
              lowest_value = temp_states[l];
              lowest_index = l;
            end
          end
{% endif %}
          counter_for_path = counter_for_path+1;
        end //end of counter_for_path==0
        else if(counter_for_path>=1 && counter_for_path<={{ stages }}) begin
          returned_path = getReturnPath(lowest_index, table_counter);
{% if tail %}
          // Traceback walks stage {{ stages }} down to 1, so the first {{ tail }} bits it
          // recovers are the zero tail.  They carried no message and are dropped.
          if (pinOut >= {{ tail }}) begin
            set_outputs(lowest_index, returned_path, pinOut-{{ tail }});
          end
{% else %}
          set_outputs(lowest_index, returned_path, pinOut);
{% endif %}
          lowest_index = returned_path;
          table_counter = table_counter-1;
          pinOut=pinOut+1;
          counter_for_path = counter_for_path+1;
        end
      end

    end
  end


  task initialize_hamming_table(input int steps, input bit bits0, input bit bits1);
    if (steps_n==1) begin
      for (int i = 0;i<8 ;i=i+1 ) begin
        h1.previousHammingDistance[i] = 0;
      end
      h1.recievedSequence[0] = bits0;
      h1.recievedSequence[1] = bits1;
      h1.step = steps;
    end
  endtask


  task copmute_for_step(input int stage_n);
    if (stage_n==0) begin
      h1.aTransition[0] = compute_hamming_distance(h1.recievedSequence[0],h1.recievedSequence[1],low,low)
                          + h1.previousHammingDistance[0];
      h1.aTransition[1] = compute_hamming_distance(h1.recievedSequence[0],h1.recievedSequence[1],high,high)
                          + h1.previousHammingDistance[0];
      h1.hammingDistances.finalStates[0] = h1.aTransition[0];
      h1.hammingDistances.finalStates[4] = h1.aTransition[1];
    end
  endtask


  function bit[4:0] compute_hamming_distance(input bit data_msb, input bit data_lsb, input bit compare_msb, input bit compare_lsb);
    begin
      if (data_msb != compare_msb && data_lsb!=compare_lsb) begin
        return 2;
      end
      else if (data_msb!=compare_msb && data_lsb==compare_lsb) begin
        return 1;
      end
      else if (data_msb==compare_msb && data_lsb!=compare_lsb) begin
        return 1;
      end
      else
        begin
          return 0;
        end
    end
  endfunction


  function bit[2:0] getReturnPath(input bit [2:0] currentState, input bit [3:0] currentTable);
    begin
      bit[2:0] returnPath;
{% for table in tables %}
      if (currentTable=={{ loop.index }}) begin
        case(currentState)
{% for rp in return_paths %}
          {{ rp.state }}: begin
            if ({{ table }}.{{ rp.field }}[{{ rp.index }}]!=3) begin
              returnPath = {{ rp.pred_even }};
            end
            else begin
              returnPath = {{ rp.pred_odd }};
            end
          end
{% endfor %}
          default: returnPath = 7;
        endcase
        return returnPath;
      end
{% endfor %}
      return 0;
    end
  endfunction


  task set_outputs(input bit[3:0] from_s, input bit[3:0] at_state,input byte pinNumber); // last to first
    begin //task begin
{% for m in output_map %}
      {% if loop.first %}if{% else %}else if{% endif %}(from_s=={{ m.from_s }} && at_state=={{ m.at_state }}) begin
        out[pinNumber] = {{ m.bit }};
      end
{% endfor %}
    end // task end
  endtask

endmodule
